# ==============================
# BhuNetra Git Ignore
# ==============================

# Dependencies
node_modules/
**/node_modules/

# Python virtual environments
venv/
.venv/
**/venv/
**/.venv/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Environment / secrets
.env
.env.*
!.env.example
frontend/.env
backend/.env

# Frontend build
dist/
**/dist/
.vite/
**/.vite/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary / backup files
*backup*
*backup.*
*before-*
*encoding-backup*
*.bak
*.tmp

# Large raw GIS / DEM data
backend/data/raw/
data/raw/

# Large temporary datasets
**/*_backup.*
**/*_before_*.*
**/*_snapshot_backup.*

# Keep trained XGBoost presentation model
!backend/ml/models/
!backend/ml/models/*.joblib

# Don't commit old generated models
*.pkl